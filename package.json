{
  "name": "amrita-connect",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @workspace/frontend dev",
    "dev:backend": "pnpm --filter @workspace/backend dev",
    "dev:frontend": "pnpm --filter @workspace/frontend dev",
    "build": "pnpm -r --if-present run build",
    "build:frontend": "pnpm --filter @workspace/frontend build",
    "build:backend": "pnpm --filter @workspace/backend build",
    "typecheck": "tsc --build"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
