# ==============================================================================
# Environment Configuration Template
# (Copy this file to `.env` and fill in your actual credentials)
# ==============================================================================

# MongoDB Cloud Atlas or local MongoDB connection URI
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/amrita_connect?retryWrites=true&w=majority"

# JWT Authentication Secret (Generate a strong random string)
SESSION_SECRET="your-jwt-secret-key-change-in-production"

# Backend API Port (Default: 5000)
PORT=5000
